torrc

echo -e "\n${ORANGE}[${NC}warn${ORANGE}]${ORANGE} Restarting ${BLUE}neptune's ${P}Anonymous Session${NC}"

pkill -9 tor >/dev/null 2>&1
pkill -9 NetworkManager >/dev/null 2>&1

config

shift
break

